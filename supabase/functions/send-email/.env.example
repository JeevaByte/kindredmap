# Secrets for the send-email auth hook.
#
# Copy to .env in this directory, fill in real values, then push them with:
#   supabase secrets set --env-file supabase/functions/send-email/.env
#
# Never commit the filled-in .env.

# Generated in Dashboard > Authentication > Hooks > Send Email > "Generate secret".
# Keep the "v1,whsec_" prefix; the function strips it.
SEND_EMAIL_HOOK_SECRET="v1,whsec_REPLACE_ME"

# From resend.com > API Keys. Needs "Sending access" only.
RESEND_API_KEY="re_REPLACE_ME"

# Must be an address on a domain you have verified in Resend.
# Resend's shared onboarding@resend.dev only delivers to your own account email,
# which is fine for testing but will not work for real members.
SEND_EMAIL_FROM="Meet Map <hello@yourdomain.com>"
